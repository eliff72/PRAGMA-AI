# PRAGMA-AI backend ortam degiskenleri (app/core/config.py > Settings).
# Kopyalayip .env olarak kaydedin: cp .env.example .env

# App
APP_NAME=PRAGMA-AI
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+psycopg://pragma:pragma@localhost:5432/pragma_ai

# Auth
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM / RAG
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
CHROMA_PERSIST_DIR=./app/data/chroma
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.35

# Not: Backend bu adresi kendi ortam degiskenlerinden OKUMAZ (asagidaki sadece
# bir referans notudur) — frontend/.env.example > VITE_API_URL bu backend'in
# calistigi adresle (varsayilan http://localhost:8000) tutarli olmalidir.
# BACKEND_URL=http://localhost:8000
