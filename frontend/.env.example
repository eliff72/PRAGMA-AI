# Backend adresi. Yerel gelistirmede localhost, production build'de dagitilmis
# backend'in TAM URL'i (ornek: https://pragma-ai-backend.onrender.com).
# NOT: Vite env degiskenleri BUILD sirasinda gomulur — degeri degistirdikten
# sonra `npm run build` tekrar calistirilmali; Vercel/Netlify'da bu degisken
# proje ayarlarindan tanimlanir.
VITE_API_URL=http://localhost:8000
# Backend calisiyorsa false birakin (varsayilan); backend hazir degilse/kapaliysa
# arayuzu mock (sahte) verilerle test etmek icin true yapabilirsiniz. true iken
# kayit/giris ekranlari GERCEK backend'e gitmez, sabit demo kullanicilar doner.
VITE_USE_MOCK=false
