# --- Backend ---
DATABASE_URL=postgresql+psycopg://pragma:pragma@localhost:5432/pragma_ai
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM / RAG ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
CHROMA_PERSIST_DIR=./app/data/chroma
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.35

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
# Varsayilan KAPALI. Sadece bilincli offline prova icin "true" yapin —
# acikken backend'e gercekten ulasilamadiginda (ag hatasi/timeout) arayuz
# mock veriye duser ve ekranda "Demo/mock veri gosteriliyor" uyarisi cikar.
# Backend ayakta ama gercek bir hata donuyorsa (401/403/404/500) bu bayrak
# acik olsa bile mock'a dusulmez, hata oldugu gibi gosterilir.
VITE_ENABLE_MOCK_FALLBACK=false
